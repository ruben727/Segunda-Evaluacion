DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your_secret_here
PORT=3000
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# Elasticsearch (buscador). Si no se define, se usa PostgreSQL (pg_trgm).
# Local con Docker:   ELASTICSEARCH_URL=http://localhost:9200
# Bonsai:             ELASTICSEARCH_URL=https://usuario:clave@xxxx.bonsaisearch.net
# Elastic Cloud:      ELASTICSEARCH_URL=https://xxxx.es.us-central1.gcp.cloud.es.io + ELASTICSEARCH_API_KEY
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=concertx
